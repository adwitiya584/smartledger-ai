server.port=8080
spring.datasource.url=jdbc:mysql://localhost:3306/smartledger_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
spring.datasource.username=root
spring.datasource.password=YOUR_DB_PASSWORD
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
spring.flyway.enabled=false
app.jwt.secret=YOUR_JWT_SECRET_MIN_32_CHARS
app.jwt.expiration=86400000
app.groq.api-key=YOUR_GROQ_API_KEY
app.cors.allowed-origins=http://localhost:3000